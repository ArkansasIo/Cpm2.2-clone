flowchart TD
    ROOT[CP/M Universal Development Environment]
    ROOT --> PRODUCT[Product]
    ROOT --> CORE[Core Runtime]
    ROOT --> CPM[CP/M Compatibility]
    ROOT --> DEV[Devices]
    ROOT --> UI[Desktop and UI]
    ROOT --> SDK[SDK and IDE]
    ROOT --> PLAT[Platforms]
    ROOT --> FW[Firmware]
    ROOT --> OS[OS Layer]
    ROOT --> UPD[Update System]
    ROOT --> TEST[Verification]
    ROOT --> ASSET[Assets]
    ROOT --> DOC[Documentation]

    CORE --> CPU[CPU]
    CPU --> Z80[Z80]
    CPU --> I8080[8080]
    CORE --> MEM[Memory]
    MEM --> RAM[64 KiB Guest RAM]
    CORE --> MACHINE[Machine]
    CORE --> EXEC[Execution]

    CPM --> CCP[CCP]
    CPM --> BDOS[BDOS]
    CPM --> BIOS[BIOS]
    CPM --> FS[Filesystem]
    FS --> FCB[FCB]
    FS --> DIR[Directory]
    FS --> ALLOC[Allocation]
    CPM --> BOOT[Boot]

    DEV --> STORAGE[Virtual Storage]
    DEV --> CONSOLE[Console]
    DEV --> PRINTER[Printer]
    DEV --> RTC[CMOS RTC]
    DEV --> AUDIO[Retro Audio]
    STORAGE --> AUDIO

    UI --> GUI[GUI Backend]
    UI --> DESKTOP[Desktop Shell]
    UI --> XMB[XMB Shell]
    UI --> FILES[File Manager]
    UI --> TERM[Terminal]
    UI --> SETTINGS[Settings]

    SDK --> CPMSDK[CP/M SDK]
    SDK --> Z80SDK[Z80 SDK]
    SDK --> I8080SDK[8080 SDK]
    SDK --> FWSDK[Firmware SDK]
    SDK --> AUDSDK[Audio SDK]
    SDK --> GUISDK[GUI SDK]

    PLAT --> LINUX[Linux]
    PLAT --> WINDOWS[Windows]
    PLAT --> MACOS[macOS]
    PLAT --> ANDROID[Android ARM64]
    PLAT --> IOS[iOS ARM64]
    PLAT --> PI[Raspberry Pi]
    PI --> PI3[Pi 3]
    PI --> PI4[Pi 4]
    PI --> PI5[Pi 5]

    FW --> FWB[Boot/Firmware]
    FW --> FWP[Patches]
    FW --> FWT[Tests]
    OS --> OSC[CCP/BDOS/BIOS]
    OS --> OSD[Drivers]
    OS --> OST[Tests]

    UPD --> MAN[Manifest]
    UPD --> VERIFY[Verification]
    UPD --> ROLLBACK[Rollback]
    UPD --> COMBINED[Combined Updates]

    TEST --> UNIT[Unit]
    TEST --> INTEGRATION[Integration]
    TEST --> COMPAT[Compatibility]
    TEST --> PLATFORMTEST[Platform]
    TEST --> RELEASE[Release]

    ASSET --> AUDIOAS[Audio]
    ASSET --> BRAND[Branding]
    ASSET --> DESKAS[Desktop]
    ASSET --> ICONS[Icons]
    ASSET --> THEMES[Themes]
    ASSET --> DISKS[Disk Images]
    ASSET --> TESTDATA[Test Data]

    DOC --> API[API Docs]
    DOC --> UML[UML Models]
    DOC --> BUILD[Build Docs]
    DOC --> PORT[Portability Docs]
    DOC --> LICENSE[References and Licenses]
